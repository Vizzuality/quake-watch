{
  "name": "quake-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && prek install || true"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "maplibre-gl": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@j178/prek": "0.5.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "1.155.2",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
